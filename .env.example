# ---------------------------------------------------------------------------
# SmashR — környezeti változók
#
# Másold .env néven a szerverre, és töltsd ki. A NEXT_PUBLIC_ előtagú érték a
# build során beépül a kódba, a többit a futó konténer olvassa, így azok
# módosítása után elég újraindítani.
# ---------------------------------------------------------------------------

# A weboldal nyilvános címe. Ebből készül a kanonikus URL, a sitemap és az
# Open Graph kép hivatkozása. Build-időben épül be.
NEXT_PUBLIC_SITE_URL=https://smashr.hu


# --- Admin felület -----------------------------------------------------------
# Mindhárom érték kell ahhoz, hogy a /admin belépés működjön. Ha bármelyik
# hiányzik, a belépőoldal megmondja, melyik.
#
# A jelszó hash-t és a munkamenet-kulcsot ezzel a paranccsal tudod előállítani:
#   node scripts/hash-password.mjs 'a választott jelszó'

SMASHR_ADMIN_USER=admin
# A jelszó soha nem kerül a fájlba, csak a scrypt hash-e: scrypt:<só>:<kulcs>
SMASHR_ADMIN_PASSWORD_HASH=
# Legalább 32 karakter, véletlenszerű. Ha megváltoztatod, minden belépés megszűnik.
SMASHR_SESSION_SECRET=

# Ahová az adminban szerkesztett tartalom (étlap, nyitvatartás, telefonszám)
# mentődik. A konténerben ez csatolt kötet, hogy túlélje az újratelepítést.
SMASHR_DATA_DIR=/data


# --- Üzemeltetői adatok a jogi oldalakhoz ------------------------------------
# Az impresszum, az adatkezelési tájékoztató, az ÁSZF és a süti tájékoztató
# ezekből az értékekből épül. Amelyik üres, ott az oldalon látható marad, hogy
# kitöltendő — soha nem találunk ki helyette adatot.

SMASHR_COMPANY_NAME=
SMASHR_COMPANY_ADDRESS=
SMASHR_COMPANY_NUMBER=
SMASHR_TAX_NUMBER=
SMASHR_REGISTRATION_COURT=
SMASHR_REPRESENTATIVE=
SMASHR_CONTACT_EMAIL=
SMASHR_PRIVACY_EMAIL=

# Tárhelyszolgáltató — az impresszumban kötelező megnevezni.
SMASHR_HOSTING_NAME=
SMASHR_HOSTING_ADDRESS=
SMASHR_HOSTING_CONTACT=
